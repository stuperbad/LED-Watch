	(footprint "RGB0808_CommonAnode"
		(layer "F.Cu")
		(uuid "0002f8c7-7482-4fb2-821a-3809e2daba35")
		(at 110.2 104.9 90)
		(descr "0.8 x 0.8 mm common-anode RGB LED, 4 pads. Fits Nationstar NCD0808RGB1 (LCSC C2917192) and Meihua MHPA0808RGBDT (LCSC C404279): both have, seen from the top, blue top-left, common anode top-right, green bottom-left, red bottom-right. Pad numbers follow the Meihua datasheet (LPDS-0002507 Rev.3 p.2): 1 = common anode, 2 = red, 3 = green, 4 = blue. Pads 0.4 x 0.4 at +-0.3 mm: Nationstar recommended land (0.4 pads, 0.2 gap); the Meihua terminals (0.3 x 0.3 at +-0.25) lie inside them.")
		(tags "LED RGB 0808 common anode")
